{
  "name": "@lavina-tech/l-signal-sdk",
  "version": "1.0.0",
  "description": "Signal React Native SDK — push notifications, in-app messages, and user identity for self-hosted Signal",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "license": "MIT",
  "author": "Lavina Tech",
  "repository": {
    "type": "git",
    "url": "https://github.com/muffix200/l-signal-sdk.git"
  },
  "homepage": "https://github.com/muffix200/l-signal-sdk#readme",
  "bugs": {
    "url": "https://github.com/muffix200/l-signal-sdk/issues"
  },
  "keywords": [
    "react-native",
    "push-notifications",
    "in-app-messages",
    "onesignal-alternative",
    "signal",
    "self-hosted",
    "notifications"
  ],
  "dependencies": {
    "axios": "^1.0.0"
  },
  "peerDependencies": {
    "@react-native-firebase/app": ">=18.0.0",
    "@react-native-firebase/messaging": ">=18.0.0",
    "react": "*",
    "react-native": "*",
    "react-native-device-info": ">=10.0.0",
    "react-native-mmkv": ">=2.0.0"
  },
  "devDependencies": {
    "@react-native-firebase/app": "^21.0.0",
    "@react-native-firebase/messaging": "^21.0.0",
    "@types/react": "^19.0.0",
    "react": "19.2.0",
    "react-native": "0.83.9",
    "react-native-device-info": "^15.0.2",
    "react-native-mmkv": "^4.3.1",
    "typescript": "^5.8.3"
  }
}
